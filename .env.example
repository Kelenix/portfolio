# ⚠️ Fichier d'EXEMPLE (commité) : ne mets JAMAIS de vraies valeurs ici.
# Copie ce fichier en `.env` (ignoré par git) et renseigne tes vraies valeurs.

# ── Base de données (Supabase / Postgres) ────────────────────────────────────
# Pooler transaction (IPv4)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
# Pooler session (migrations / db push)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Génère avec : openssl rand -base64 32
AUTH_SECRET="your-auth-secret"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# ── Admin (obligatoire pour le seed — mot de passe 12 caractères minimum) ─────
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me-min-12-chars"
ADMIN_USERNAME="admin"
ADMIN_NAME="Your Name"

# ── Supabase Storage ─────────────────────────────────────────────────────────
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── Notifications chat (facultatif) ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN="123456:ABC..."
TELEGRAM_CHAT_ID="123456789"

# ── Chariow (vitrine des formations) ─────────────────────────────────────────
# Clé API : app.chariow.com → Settings → API Keys → Create API Key
CHARIOW_API_KEY="sk_live_..."
# URL publique de ta boutique (pour les liens d'achat)
CHARIOW_STORE_URL="https://ebookdev.mychariow.shop"
