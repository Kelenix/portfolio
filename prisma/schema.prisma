generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String?  @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  actorEmail  String?
  ip          String?
  userAgent   String?  @db.Text
  metadata    String   @default("") @db.Text
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

model Project {
  id          String   @id @default(cuid())
  titleFr     String
  titleEn     String
  titleIt     String
  descFr      String
  descEn      String
  descIt      String
  url         String?
  github      String?
  tags        String   @default("[]")
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Accomplishment {
  id          String   @id @default(cuid())
  textFr      String
  textEn      String
  textIt      String
  link        String?
  linkLabel   String?
  linkLabelEn String?
  linkLabelIt String?
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SocialLink {
  id        String   @id @default(cuid())
  platform  String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Profile {
  id         String   @id @default(cuid())
  nameFr     String   @default("")
  nameEn     String   @default("")
  nameIt     String   @default("")
  roleFr     String   @default("")
  roleEn     String   @default("")
  roleIt     String   @default("")
  bioFr      String   @default("")
  bioEn      String   @default("")
  bioIt      String   @default("")
  email      String   @default("")
  photoUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Skill {
  id        String   @id @default(cuid())
  name      String
  iconName  String   @default("")
  category  String   @default("tools")
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MobileApp {
  id            String   @id @default(cuid())
  name          String
  descFr        String   @default("")
  descEn        String   @default("")
  descIt        String   @default("")
  iconUrl       String   @default("")
  playStoreUrl  String?
  appStoreUrl   String?
  order         Int      @default(0)
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FooterLink {
  id        String   @id @default(cuid())
  labelFr   String
  labelEn   String
  labelIt   String
  url       String
  column    String   @default("formations")
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id          String    @id @default(cuid())
  titleFr     String
  titleEn     String
  titleIt     String
  contentFr   String    @default("") @db.Text
  contentEn   String    @default("") @db.Text
  contentIt   String    @default("") @db.Text
  slug        String    @unique
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
